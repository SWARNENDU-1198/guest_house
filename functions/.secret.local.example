# Copy to functions/.secret.local for the emulator. Never commit real values.
# In production set each with: firebase functions:secrets:set NAME
SERVER_SECRET=dev-only-change-me-to-a-long-random-string
# These two equal the built-in mock gateway's secrets; replace with your Razorpay
# test-mode key secret / webhook secret (and set RAZORPAY_KEY_ID in .env) to use real Razorpay.
RAZORPAY_KEY_SECRET=mock_key_secret_for_local_dev_only
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret_for_local_dev_only
MAIL_PASS=unused-with-json-transport
CRON_SECRET=dev-cron-secret-change-me-0123456789
