# In production set each with: firebase functions:secrets:set NAME
SERVER_SECRET=dev-only-change-me-to-a-long-random-string
# Leave the Razorpay secrets empty to use the built-in mock gateway.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAIL_PASS=
CRON_SECRET=
