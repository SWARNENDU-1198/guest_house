{
  "name": "guesthouse-api",
  "version": "0.2.0",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --project demo-guesthouse",
    "seed": "node scripts/seed.js",
    "test": "cd .. && firebase emulators:exec --project demo-guesthouse --only auth,firestore \"cd functions && npm run test:raw\"",
    "test:raw": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "deploy": "cd .. && firebase deploy --only firestore:rules,firestore:indexes,functions"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "supertest": "^7.3.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "22"
  }
}
