# Non-secret configuration (copy to functions/.env). Secrets go in .secret.local / Secret Manager.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:5173
# Razorpay public key id (test mode: rzp_test_...). Empty = mock gateway.
RAZORPAY_KEY_ID=
# RAZORPAY_MOCK=true forces the mock gateway even when keys are set.
RAZORPAY_MOCK=
# json (log only) | gmail (MAIL_USER + MAIL_PASS app password) | smtp (MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASS)
MAIL_TRANSPORT=json
MAIL_FROM=Guest House <no-reply@guesthouse.local>
MAIL_USER=
# UIDAI secure-QR certificate path (default functions/config/uidai_cert.pem)
UIDAI_CERT_PATH=
# Demo only: accept Aadhaar QRs without a signature check when no certificate is present
AADHAAR_ALLOW_UNSIGNED=
# Rate limits per user per minute (RATE_LIMITS=off disables; tests only)
RATE_LIMIT_GENERAL=30
RATE_LIMIT_AADHAAR=5
RATE_LIMIT_BOOKING=10
# Scheduled reminder cadence; use "every 1 minutes" for a live demo
REMINDER_SCHEDULE=every 60 minutes
